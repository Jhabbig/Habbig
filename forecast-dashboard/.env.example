# Local development: bypasses gateway SSO auth entirely.
DEV_MODE=1

# Board horizon — markets ending within N days are ingested and displayed.
FORECAST_HORIZON_DAYS=7

# Injected by the gateway in production; leave unset locally.
# GATEWAY_SSO_SECRET=

# Optional — used by models_fed.py for FRED series lookups.
# FRED_API_KEY=

# Claude forecasting (scored llm model, /api/ask forecasts, custom-market
# adjudication). Off by default — it spends API tokens.
# FORECAST_LLM_ENABLED=1
# FORECAST_LLM_DAILY_CAP=25

# Metaculus API token — anonymous API reads 403 as of 2026-08. Without it the
# metaculus venue ingests nothing and its markets stay pending.
# METACULUS_API_TOKEN=

# Override the sqlite location (defaults to data/forecast.sqlite).
# FORECAST_DB_PATH=
