# Local development: bypasses gateway SSO auth entirely.
DEV_MODE=1

# Board horizon — markets ending within N days are ingested and displayed.
FORECAST_HORIZON_DAYS=7

# Injected by the gateway in production; leave unset locally.
# GATEWAY_SSO_SECRET=

# Optional — used by models_fed.py for FRED series lookups.
# FRED_API_KEY=

# Override the sqlite location (defaults to data/forecast.sqlite).
# FORECAST_DB_PATH=
