# ── Flask ───────────────────────────────────────────────────────────────────
# Session signing key. If unset, a random key is generated each restart
# (sessions won't persist across restarts).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET=

# Set to 1 to enable Flask debug mode (auto-reload, debugger). Never in prod.
FLASK_DEBUG=0

# Set to 1 in production. Used by the WSGI runner branch.
PRODUCTION=0

# ── Gateway SSO ─────────────────────────────────────────────────────────────
# Shared secret with gateway/.env. Required when running behind the gateway.
GATEWAY_SSO_SECRET=

# Set to 1 to bypass gateway auth when running standalone for local dev.
DEV_MODE=

# ── Merged Disasters section ─────────────────────────────────────────────────
# Set to 1 to pre-warm the ~20 disaster feeds (NHC, USGS, EONET, SPC, ...) on
# a background schedule so the Disasters tab loads instantly. Off by default
# so smoke tests never hit live upstreams.
DISASTERS_PREFETCH=0

# Optional AirNow API key for the metro AQI panel on the Disasters tab.
AIRNOW_API_KEY=

# Override the disasters disk-cache directory (defaults to ./cache).
#DISASTERS_CACHE_DIR=
