# ── Gateway ─────────────────────────────────────────────────────────────────
PRODUCTION=0
GATEWAY_COOKIE_SECRET=change-me-to-a-random-string
GATEWAY_SSO_SECRET=shared-secret-between-gateway-and-dashboards

# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use the local SQLite file (gateway/auth.db).
# Set it to a postgres:// URL to use PostgreSQL (recommended for production).
# DATABASE_URL=postgres://narve:narve@localhost:5432/narve
# Connection-pool tuning (Postgres only; sensible defaults shown):
# DB_POOL_MIN=2              # warm connections kept open
# DB_POOL_MAX=10             # max pooled connections
# DB_POOL_MAX_IDLE=300       # close idle connections after N seconds
# DB_POOL_MAX_LIFETIME=1800  # recycle each connection after N seconds
# DB_POOL_TIMEOUT=10         # max seconds to wait for a free connection
# DB_PREPARE_THRESHOLD=2     # server-side prepare a query after N uses

# ── Stripe (billing) ───────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (password resets, enquiry notifications) ──────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# ENQUIRY_EMAIL=notifications@yourdomain.com
